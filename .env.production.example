# Copy this file to .env in the repository root. Never commit the populated file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_USER=kingflow
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_DATABASE=kingflow_barber

# URL-encode special characters in MYSQL_PASSWORD before placing it in this URL.
DATABASE_URL=mysql+pymysql://kingflow:replace-with-a-long-random-password@db:3306/kingflow_barber
SECRET_KEY=replace-with-at-least-48-random-bytes
CORS_ORIGINS=["https://app.example.com"]
FRONTEND_BASE_URL=https://app.example.com
# The same-host trusted reverse proxy overwrites this header with the client IP.
CLIENT_IP_HEADER=X-Real-IP
WHATSAPP_API_TOKEN=replace-with-a-private-random-token

# SMTP is optional; without it, email notices are not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
