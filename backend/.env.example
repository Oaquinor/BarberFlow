# Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=KingFlow Barber
ENVIRONMENT=development
DEBUG=True
API_VERSION=v1
FRONTEND_BASE_URL=http://localhost:8000
# In production set the public HTTPS origin serving the frontend, without a trailing path.

# Database
DATABASE_URL=mysql+pymysql://kingflow:choose-a-local-password@localhost:3307/kingflow_barber
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=http://127.0.0.1:3001/send

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]
# For production, replace this with a JSON list of the public HTTPS origins only.

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@kingflow.com

# File Storage (defaults to the shared frontend/uploads directory)
MAX_UPLOAD_SIZE=5242880

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Features
ENABLE_MULTI_TENANT=True
ENABLE_ANALYTICS=True
