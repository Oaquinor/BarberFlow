# Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=KingFlow Barber
ENVIRONMENT=development
DEBUG=True
API_VERSION=v1

# Database
DATABASE_URL=postgresql+asyncpg://kingflow:kingflow123@localhost:5432/kingflow_barber
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@kingflow.com

# Push Notifications (Optional)
FIREBASE_CREDENTIALS=

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Features
ENABLE_MULTI_TENANT=True
ENABLE_ANALYTICS=True

# Celery (Optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
